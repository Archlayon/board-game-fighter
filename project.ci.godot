; Engine configuration file for CI export
; Editor-only plugins disabled for headless export

config_version=5

[application]

config/name="Board Game Fighter"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameAudio="*res://scripts/game_audio.gd"
SyncManager="*uid://ciu812uibjjdn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-rollback-netcode/plugin.cfg", "res://addons/health_hitbox_hurtbox/plugin.cfg")

